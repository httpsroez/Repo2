    <script>
        // Script mejorado para el carrusel automático
        let currentSlide = 0;
        const slides = document.querySelectorAll('.carousel-slide');
        const dots = document.querySelectorAll('.control-dot');
        const totalSlides = slides.length;
        let slideInterval;
        let isPaused = false;

        function updateCarousel() {
            const carouselInner = document.querySelector('.carousel-inner');
            carouselInner.style.transform = `translateX(-${currentSlide * 33.333}%)`;

            // Actualizar puntos de control
            dots.forEach((dot, index) => {
                dot.classList.toggle('active', index === currentSlide);
            });
        }

        function nextSlide() {
            if (!isPaused) {
                currentSlide = (currentSlide + 1) % totalSlides;
                updateCarousel();
            }
        }

        function goToSlide(slideIndex) {
            currentSlide = slideIndex;
            updateCarousel();
            resetInterval();
        }

        function resetInterval() {
            clearInterval(slideInterval);
            slideInterval = setInterval(nextSlide, 5000);
        }

        // Iniciar carrusel automático con pausa al interactuar
        function startCarousel() {
            slideInterval = setInterval(nextSlide, 5000);

            const carousel = document.querySelector('.carousel');

            // Pausar al hacer hover o tocar
            carousel.addEventListener('mouseenter', () => {
                isPaused = true;
            });

            carousel.addEventListener('mouseleave', () => {
                isPaused = false;
                resetInterval();
            });

            // Para dispositivos táctiles
            carousel.addEventListener('touchstart', () => {
                isPaused = true;
                clearInterval(slideInterval);
            });

            carousel.addEventListener('touchend', () => {
                isPaused = false;
                resetInterval();
            });
        }

        // Inicializar
        document.addEventListener('DOMContentLoaded', () => {
            updateCarousel();
            startCarousel();

            // Efecto smooth para los enlaces
            document.querySelectorAll('a[href^="#"]').forEach(anchor => {
                anchor.addEventListener('click', function(e) {
                    e.preventDefault();
                    document.querySelector(this.getAttribute('href')).scrollIntoView({
                        behavior: 'smooth'
                    });
                });
            });

            // Añadir clase active al hacer scroll
            window.addEventListener('scroll', function() {
                const header = document.querySelector('header');
                if (window.scrollY > 50) {
                    header.style.boxShadow = '0 4px 12px rgba(0, 0, 0, 0.1)';
                } else {
                    header.style.boxShadow = '0 4px 12px rgba(0, 0, 0, 0.05)';
                }
            });
        });
    </script>
</body>
</html>